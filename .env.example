# Copy to .env and fill in. Share real values through the password manager, never in git.

# Boson / Higgs
BOSON_API_KEY=
HIGGS_VOICE_RENTER=default
HIGGS_VOICE_LISTING=default
HIGGS_MAX_SESSIONS=5            # set from the A-01 spike (close code 1013 above this)

# Text LLM for extraction and memory (OpenAI-compatible structured outputs)
LLM_PROVIDER=                   # openai | openrouter | gemini | boson (Higgs text, on BOSON_API_KEY)
LLM_MODEL=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Database (Postgres 17 + PostGIS + pgvector). Unset, the API serves the latest scrape, else the web
# fixture, so it never tries a Postgres that isn't running. After `make db-up`, uncomment:
# DATABASE_URL=postgresql://landline:landline@localhost:54329/landline

# Telephony
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=            # E.164
DEMO_AGENT_PHONES=              # comma-separated E.164; teammates only. Nothing else is ever dialled
TRANSPORT=stub                  # stub | sim | voice
FORCE_BUSINESS_HOURS=0

# Serving
# Production values live in deploy/production.env; secrets in ~/landline/.env on the VM.
PUBLIC_URL=                     # https://landline.134.87.8.230.sslip.io in production
WEB_URL=                        # the web app's origin; allowed by CORS
CORS_ORIGINS=                   # more browser origins that may call the API directly, comma-separated
CORS_ORIGIN_REGEX=              # optional, e.g. Vercel previews of our project

# Judge mode (/try)
JUDGE_AUDIO_READY=0             # 1 opens /try; keep 0 until the browser audio (A-03) is live
JUDGE_STARTS_PER_IP=3           # sessions one address may start per window; raise on judging day (one venue Wi-Fi)
JUDGE_START_WINDOW_S=600        # that window, in seconds

# Admin panel (/admin): renters, their calls and transcripts. Unset, the admin API answers 404.
# Use a long random value (openssl rand -hex 24) and share it through the password manager.
# `make db-pull` uses the same token to copy production's data into your local database.
ADMIN_TOKEN=
# Store both sides of each call's audio for the admin panel (A-10). On by default; 0 turns it off.
RECORD_AUDIO=1

# Web app. `next dev` and `next build` read these from the shell or web/.env.local, not from this file;
# production sets both in .github/workflows/deploy-web.yml.
# API_URL=http://localhost:8000     # where the web app's /api proxy points (next.config.ts)
# NEXT_PUBLIC_API_URL=              # set to have the browser call the API directly instead (needs CORS)

# Pipeline
GEOCODER=nominatim              # nominatim | google
GOOGLE_MAPS_API_KEY=
SCRAPER_CONTACT_EMAIL=          # goes into the User-Agent
