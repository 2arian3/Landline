# Copy to .env and fill in. Share real values through the password manager, never in git.

# Boson / Higgs
BOSON_API_KEY=
HIGGS_VOICE_RENTER=default
HIGGS_VOICE_LISTING=default
HIGGS_MAX_SESSIONS=8            # A-01: 8 opened with no 1013; keep one slot for the renter

# Text LLM for extraction and memory (OpenAI-compatible structured outputs)
LLM_PROVIDER=                   # openai | openrouter | gemini
LLM_MODEL=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Database (Supabase Postgres with PostGIS + pgvector)
DATABASE_URL=

# Telephony
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=            # E.164
DEMO_AGENT_PHONES=              # comma-separated E.164; teammates only. Nothing else is ever dialled
TRANSPORT=stub                  # stub | sim | voice
FORCE_BUSINESS_HOURS=0

# Serving
PUBLIC_URL=                     # https://api.<domain> (VM, Caddy TLS)
WEB_URL=                        # https://<vercel app>

# Pipeline
GEOCODER=nominatim              # nominatim | google
GOOGLE_MAPS_API_KEY=
SCRAPER_CONTACT_EMAIL=          # goes into the User-Agent
