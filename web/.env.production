# Built into production builds only (Next loads this file for `next build`, never for `next dev` or the
# tests). A value set on Vercel still wins over it.
# Clerk's publishable key is public by design: it ships in every page's JavaScript anyway. A secret
# (CLERK_SECRET_KEY or anything like it) never goes in this file; secrets stay on the VM and in the
# password manager.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_aW5maW5pdGUtZGVlci04ODMxLmNsZXJrLmFjY291bnRzLmRldiQ
