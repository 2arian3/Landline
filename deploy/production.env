# Non-secret settings for the API and the refresh job on the Landline VM.
# Committed, so a change here ships with the next deploy. systemd loads this file,
# and its values win over ~/landline/.env, which holds only the secrets.
# systemd syntax: KEY=value, whole-line comments only.

PUBLIC_URL=https://landline.134.87.8.230.sslip.io

# The web app's own origin (Vercel production domain). Allowed by CORS.
WEB_URL=https://landline-mu.vercel.app

# Other browser origins that may call the API directly (comma-separated, exact,
# scheme://host[:port]). localhost:3000 is always allowed for local development.
CORS_ORIGINS=https://landline.134.87.8.230.sslip.io

# Optional regex for Vercel preview deployments, scoped to our project, e.g.
# https://landline-[a-z0-9-]+-<team>\.vercel\.app
CORS_ORIGIN_REGEX=

# voice: phone renters' listing calls go out through Twilio, to the allowlisted DEMO_AGENT_PHONES only,
# between 09:00 and 20:00 Toronto time (FORCE_BUSINESS_HOURS=1 lifts the hours). Browser and /try
# sessions keep the sim landlords.
TRANSPORT=voice

# Higgs lines (U-06). HIGGS_MAX_SESSIONS lets one judge on /try and one renter on the phone in at a time:
# a judge's calls to three listings use about 6 Higgs sessions (the Caller and a sim landlord per call).
# CALL_CONCURRENCY keeps up to 3 listing calls running at once across every session; without it the
# Dispatcher would allow HIGGS_MAX_SESSIONS - 1, at least 1. At most 1 + 1 + 3 x 2 = 8 Higgs sessions are
# open at once, as many as the A-01 spike opened without a 1013.
HIGGS_MAX_SESSIONS=1
CALL_CONCURRENCY=3

# The prod Twilio number: outbound listing calls (A-02) and the results text come from it.
# Renters call this one. Local .env files hold the dev number, whose webhook is a teammate's tunnel.
TWILIO_PHONE_NUMBER=+12895122338

# Judge mode (/try) answers "opens soon" while this is 0. On since Fri 23 Oct: the browser audio (A-03)
# reaches Higgs, and the Concierge's greeting comes back in about a second.
JUDGE_AUDIO_READY=1
