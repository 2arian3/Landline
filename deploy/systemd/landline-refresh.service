[Unit]
Description=Landline listings refresh (scrape liv.rent, check, load; then neighbourhoods, stations, light)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/landline
EnvironmentFile=/home/ubuntu/landline/deploy/production.env
Environment=PYTHONPATH=server:.
# The run refuses to load fewer than 500 listings, so a block or a site change
# never overwrites good data (exit 3). SCRAPER_CONTACT_EMAIL comes from .env.
ExecStart=/home/ubuntu/landline/.venv/bin/python -m pipeline run --source livrent --no-cache \
    --max-pages 40 --min-listings 500 --load
# Then where each listing is (neighbourhood, nearest station; D-05) and how much light it gets (D-07). Both
# are cached, so a run only fetches what's new. The "-" lets the refresh carry on if either fails (the
# City's site down, say): new listings still load and the API still restarts.
ExecStart=-/home/ubuntu/landline/.venv/bin/python -m pipeline geo --load
# Google's walking minutes to the TTC (D-10a) replace geo's straight-line estimate, so this runs right after
# it. Its answers are cached, so only new listings cost anything; without GOOGLE_MAPS_API_KEY it skips.
ExecStart=-/home/ubuntu/landline/.venv/bin/python -m pipeline maps --load
ExecStart=-/home/ubuntu/landline/.venv/bin/python -m pipeline light --photos 2 --load
# The API reads the catalogue at startup; restart it so new listings show up.
ExecStartPost=+/usr/bin/systemctl try-restart landline-api.service
# The first light run measures every listing's photos (about an hour); later ones only the new listings'.
TimeoutStartSec=90min
